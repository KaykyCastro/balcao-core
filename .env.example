# =====================================================================================================
# balcao-core (API) — copie para .env e preencha.   cp .env.example .env
# Em produção (NODE_ENV=production) a API NÃO sobe se faltar algo marcado [OBRIGATÓRIA] (common/config/env.ts).
# Nunca coloque este arquivo no git. Guarde uma cópia das chaves fora do servidor (gerenciador de senhas).
# =====================================================================================================

NODE_ENV=production
PORT=2700

# --- Endereços --------------------------------------------------------------------------------------
# [OBRIGATÓRIA] URL pública da API, em HTTPS. Vira o endereço dos webhooks do Mercado Pago.
APP_URL=https://api.seudominio.com.br
# [OBRIGATÓRIA] URL pública do site (balcao-web). Links dos e-mails, volta do pagamento, convites.
FRONTEND_URL=https://seudominio.com.br
# [OBRIGATÓRIA] Quem pode chamar a API pelo navegador (separe por vírgula). Normalmente só o site.
CORS_ORIGIN=https://seudominio.com.br
# API atrás de proxy (nginx, Caddy, Cloudflare): 1 = confia no primeiro proxy. Sem isso, o limite de
# tentativas de login vê todos os clientes como um IP só.
TRUST_PROXY=1
# Site e API em subdomínios do mesmo domínio: deixe vazio (o cookie fica no domínio da API) e mantenha lax.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Banco (MongoDB com replica set: as vendas usam transações) -------------------------------------
# [OBRIGATÓRIA] Com o docker-compose.prod.yml, troque usuário e senha pelos do MONGO_ROOT_* (mesmo valor).
# Atlas: Database → Connect → Drivers (já é replica set; libere só o IP da VPS em Network Access).
MONGO_URI=mongodb://balcao:TROQUE_A_SENHA_DO_BANCO@127.0.0.1:27017/balcao?authSource=admin&replicaSet=rs0
# Só na primeira subida (ou ao criar coleções novas): cria os índices. Depois volte para false.
MONGO_AUTO_INDEX=true
# Usado só pelo docker-compose.prod.yml (usuário root do Mongo). Senha longa e aleatória.
MONGO_ROOT_USER=balcao
MONGO_ROOT_PASSWORD=TROQUE_A_SENHA_DO_BANCO

# --- Chaves secretas (gere na VPS; NUNCA reaproveite as de desenvolvimento) --------------------------
# [OBRIGATÓRIA] Assina as sessões. 32+ caracteres aleatórios:  openssl rand -base64 48
# Trocar derruba todas as sessões (todo mundo entra de novo). Não afeta os dados criptografados.
JWT_SECRET=
# [OBRIGATÓRIA] Criptografa telefone, CPF, endereços e tokens do Mercado Pago:  openssl rand -base64 32
# ATENÇÃO: sem esta chave os dados criptografados não abrem nunca mais. Guarde uma cópia fora do servidor.
SECRETS_KEY=
JWT_EXPIRES_IN=8h
JWT_MOBILE_EXPIRES_IN=30d
JWT_STAFF_MOBILE_EXPIRES_IN=7d

# --- Administrador da plataforma --------------------------------------------------------------------
# Cria o admin na primeira subida (não troca a senha de conta que já existe). Depois, pode apagar a senha daqui.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=

# --- E-mail (código de login, avisos de fatura, convites) ------------------------------------------
# [OBRIGATÓRIA] Formato: smtps://USUARIO:SENHA@HOST:465   ou   smtp://USUARIO:SENHA@HOST:587
# (caracteres especiais na senha: troque por %XX, ex.: @ vira %40)
# - Amazon SES: console AWS → Amazon SES → SMTP settings → Create SMTP credentials (região, ex.: sa-east-1).
#   Verifique o domínio em "Verified identities" e peça a saída do sandbox. Host: email-smtp.sa-east-1.amazonaws.com
# - Resend: resend.com → Domains (verifique o domínio) → API Keys. Usuário "resend", senha = a API key, host smtp.resend.com
# - Brevo: app.brevo.com → SMTP & API → SMTP. Host smtp-relay.brevo.com:587
# Em qualquer um, configure SPF e DKIM no DNS do domínio (o painel mostra os registros), senão vai para o spam.
SMTP_URL=smtps://USUARIO:SENHA@email-smtp.sa-east-1.amazonaws.com:465
# Remetente: precisa ser de um domínio verificado no provedor.
MAIL_FROM=Balcão <nao-responda@seudominio.com.br>

# --- Mercado Pago (conta do Balcão: recebe as faturas e as comissões da loja online) ----------------
# [OBRIGATÓRIA] mercadopago.com.br/developers/panel → Suas integrações → Criar aplicação (com a conta que
# vai RECEBER). Em "Credenciais de produção": Access Token (começa com APP_USR-).
MP_ACCESS_TOKEN=APP_USR-
# Na mesma aplicação: ative OAuth/marketplace e cadastre a Redirect URL abaixo. Client ID e Client Secret ficam
# em "Credenciais de produção". Sem estas três, a loja online não conecta o Mercado Pago dos lojistas.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://seudominio.com.br/app/loja/mercadopago
# Na aplicação → Webhooks: cadastre https://api.seudominio.com.br/billing/webhook/mercadopago/assinatura
# (eventos "Planos e assinaturas") e copie a "Assinatura secreta" aqui. Recomendado (confere a origem do aviso).
MP_WEBHOOK_SECRET=

# --- Arquivos: Cloudflare R2 (fotos, logos, banners, vídeos) ----------------------------------------
# [OBRIGATÓRIA as 5] dash.cloudflare.com → R2 → Create bucket. Account ID: na página do R2 (32 caracteres).
# R2 → Manage R2 API Tokens → Create API token (Object Read & Write, só neste bucket): Access Key ID e Secret.
# Endereço público: no bucket → Settings → Public access → Custom domain (ex.: arquivos.seudominio.com.br).
# CORS do bucket (Settings → CORS policy): permitir PUT e GET de https://seudominio.com.br
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=balcao-arquivos
R2_PUBLIC_URL=https://arquivos.seudominio.com.br

# --- Login com Google (opcional: sem as duas, o botão some) -----------------------------------------
# console.cloud.google.com → APIs e serviços → Tela de consentimento OAuth (externo) → Credenciais →
# Criar ID do cliente OAuth (Aplicativo da Web). URI de redirecionamento autorizado:
#   https://api.seudominio.com.br/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Padrão: ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
# Volta do login Google no app instalado (não mude, a não ser que mude o "scheme" do app).
APP_GOOGLE_RETURN_URL=balcao://google

# --- WhatsApp dos avisos de fatura (opcional: sem isso, só e-mail e painel) --------------------------
# business.facebook.com → crie o app no developers.facebook.com (tipo Business) → produto WhatsApp →
# API Setup: Phone number ID. Token permanente: Business Settings → Usuários do sistema → Gerar token
# (permissões whatsapp_business_messaging e whatsapp_business_management).
# Crie e aprove o modelo (categoria Utilidade, idioma pt_BR) com 4 variáveis — texto sugerido em BILLING.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_INVOICE=balcao_fatura
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Maquininha Stone (opcional) --------------------------------------------------------------------
# Só depois de aprovado no Stone Partner Program (parceiros.stone.com.br): eles informam o ServiceRefererName.
STONE_SERVICE_REFERER_NAME=

# --- Privacidade (LGPD) --------------------------------------------------------------------------
# E-mail do encarregado (DPO): recebe os pedidos de titulares abertos em /privacidade/solicitacao. Vazio = ADMIN_EMAIL.
# Use o mesmo e-mail de PROVIDER.dpoEmail em balcao-web/src/config/terms.ts (é o que aparece nas políticas).
PRIVACY_EMAIL=

# --- Cobrança e segurança ---------------------------------------------------------------------------
# Dias para pagar a fatura antes do bloqueio (padrão 15).
BILLING_GRACE_DAYS=15
# Isolamento entre lojas: warn (registra no log) | strict (recusa). Comece com warn; sem avisos
# "IsolamentoLojas" no log por um tempo, troque para strict.
TENANT_GUARD=warn
